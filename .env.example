SUPABASE_REGION=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
PUBLIC_CONTACT_NOTIFICATION_EMAIL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_CERT_URL=
PAYPAL_WEBHOOK_CERTIFICATE_PEM_BASE64=
PAYPAL_ALLOWED_CURRENCIES=
CMI_ENV=demo
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
CMI_GATEWAY_ALLOWED_HOSTS=
OPENAI_API_KEY=
APP_ENCRYPTION_KEY=
CRON_SECRET=
INTERNAL_WEBHOOK_SECRET=
WORKER_DISPATCH_URL=
WORKER_DISPATCH_ALLOWED_HOSTS=
CLAMAV_HOST=
CLAMAV_ALLOWED_HOSTS=
CLAMAV_NETWORK_MODE=PRIVATE
CLAMAV_PORT=3310
# Expected engine version pin; native VERSION is still mandatory.
CLAMAV_ENGINE_VERSION=
# Native signature DB age limit: default48hours, allowed1..168; ClamAV TZ=UTC.
CLAMAV_MAX_DATABASE_AGE_HOURS=
CLAMAV_TIMEOUT_MS=15000
CLAMAV_CHUNK_BYTES=65536
# HTTPS worker /scan behind Railway TLS; exact public hostname allowlist.
# Version2:10MiB bytes (~13.34MiB base64 JSON), signed fresh nonce response.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_ALLOWED_HOSTS=
# Same distinct secret on web and worker; never copy a chat-exposed value.
MALWARE_SCANNER_TOKEN=
DELIVERY_PROOF_SCANNER_MODE=EXTERNAL
PAYMENT_PROVIDER=demo
PAYMENT_PROVIDER_ALLOWLIST=demo
PAYMENT_LIVE_ENABLED=false
PAYMENT_WEBHOOK_SECRET_DEMO=
EMAIL_DELIVERY_MODE=
EMAIL_LIVE_DELIVERY_ENABLED=false
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_ENDPOINT_ALLOWLIST=
EMAIL_PROVIDER_TOKEN=
MARKETING_AUTOPILOT_ENABLED=false
MARKETING_PUBLISH_MODE=sandbox
MARKETING_LIVE_PUBLISHING_ENABLED=false
MARKETING_CONTENT_PROVIDER_URL=
MARKETING_CONTENT_PROVIDER_ENDPOINT_ALLOWLIST=
MARKETING_CONTENT_PROVIDER_API_KEY=
MARKETING_CTA_SIGNING_SECRET=
# Credential JSON is resolved only through an env://NAME reference stored by the admin workflow.
MATRICIA_SOCIAL_LINKEDIN=
MATRICIA_SOCIAL_META=
MATRICIA_DEMO_ACCESS_ENABLED=false
MATRICIA_DEMO_CLIENT_EMAIL=
MATRICIA_DEMO_CLIENT_PASSWORD=
MATRICIA_DEMO_PROVIDER_EMAIL=
MATRICIA_DEMO_PROVIDER_PASSWORD=
MATRICIA_DEMO_ADMIN_EMAIL=
MATRICIA_DEMO_ADMIN_PASSWORD=
MATRICIA_DEMO_FRANCHISE_EMAIL=
MATRICIA_DEMO_FRANCHISE_PASSWORD=
MATRICIA_DEMO_MARKETING_EMAIL=
MATRICIA_DEMO_MARKETING_PASSWORD=

# Integration activation is fail-closed; keep values in the hosting secret manager.
RESEND_WEBHOOK_SECRET=
MARKETING_CONTENT_FALLBACK_PROVIDER_URL=
MARKETING_CONTENT_FALLBACK_PROVIDER_ENDPOINT_ALLOWLIST=
MARKETING_CONTENT_FALLBACK_PROVIDER_API_KEY=
READINESS_REQUIRED_SERVICES=
INTERNAL_METRICS_TOKEN=
WORKER_LOCAL_SUPABASE_ENABLED=
WORKER_LOCAL_SUPABASE_PROJECT_ID=
SIGNATURE_PROVIDER_MODE=
SIGNATURE_PROVIDER_CODE=
BILLING_ISSUER_LEGAL_NAME=
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_ICE=
BILLING_ISSUER_VERSION=
# Server OTP length must match the GoTrue mailer configuration (supported: 6, 7 or 8; default: 6).
AUTH_EMAIL_OTP_LENGTH=

# The privacy-file-scans cron uses CRON_SECRET and the shared authenticated HTTP scanner.
# PRIVACY_FILE_SCANNER is a required production heartbeat. CLEAN is AV only, never redaction approval.
# ZIP is blocked with ARCHIVE_SCAN_CAPABILITY_REQUIRED until native archive/encryption/limit handling
# has a verified protocol and recipe. No environment flag asserts that capability.
